# Airtable Configuration
# Get these values from your Airtable base:
# 1. API Key: Go to https://airtable.com/create/tokens
# 2. Base ID: Found in your Airtable base URL: https://airtable.com/[BASE_ID]/tbl...

VITE_AIRTABLE_API_KEY=your_api_key_here
VITE_AIRTABLE_BASE_ID=your_base_id_here

# Audience Reviews base (table name is "Reviews"; filter Select containing 6SC)
VITE_AIRTABLE_AUDIENCE_REVIEWS_BASE_ID=your_audience_reviews_base_id
VITE_AIRTABLE_AUDIENCE_REVIEWS_TABLE_NAME=Reviews
